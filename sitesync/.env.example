# Copy to .env.local and fill in from Supabase > Project Settings > API.
# Only the anon (publishable) key is used. No service-role key is needed or used.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Public URL of this app, used to build invitation and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: email notifications (see README "Email notifications") ---
# Server-side only. Leave unset to keep notifications in-app only.
EMAIL_WEBHOOK_SECRET=a-long-random-string
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="SiteSync <notifications@your-verified-domain.com>"
